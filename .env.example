# Copy to .env locally, or inject these environment variables with your secret manager.
# Never commit a real .env. No private key or seed phrase is needed.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
ERPC_RPC_KEY=
# Public address of a funded, disposable SOLANA TESTNET account, for unsigned simulation only.
# The app never has its private key and never sends a transaction.
SOLANA_TESTNET_SENDER=
PORT=4173
